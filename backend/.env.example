# =============================================================================
# ORBIT AI BACKEND - ENVIRONMENT TEMPLATE
# =============================================================================
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-3.5-flash-lite

# MongoDB Atlas or Local MongoDB Connection URI
# Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/orbit_ai?retryWrites=true&w=majority
# Local: mongodb://localhost:27017/orbit_ai
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/orbit_ai?retryWrites=true&w=majority
DATABASE_NAME=orbit_ai

SECRET_KEY=replace-with-a-random-secure-secret-key-at-least-32-chars
FLASK_ENV=production
# Set to your Vercel domains (comma-separated, wildcards like *.vercel.app supported for preview deploys)
# Production example: FRONTEND_URL=https://orbit-ai.vercel.app,https://*.vercel.app,http://localhost:3000
FRONTEND_URL=http://localhost:3000
MAX_CONTEXT_MESSAGES=16
MAX_MESSAGE_LENGTH=8000
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
