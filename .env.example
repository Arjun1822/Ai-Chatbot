# =============================================================================
# ORBIT AI AGENT PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# Copy this file to '.env' (for Docker Compose and root environment)
# and/or to 'backend/.env' (for local Python backend development).
#
# IMPORTANT SECURITY NOTES:
# 1. Never commit '.env' or real credentials to version control.
# 2. Both '.env' and 'backend/.env' are explicitly ignored in .gitignore.
# =============================================================================

# Google Gemini API Key (Required for AI responses and agent tool reasoning)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite

# MongoDB Atlas Connection URI (Required for cloud persistent storage)
# Format for MongoDB Atlas Cluster:
# MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster_name>.xxxxx.mongodb.net/orbit_ai?retryWrites=true&w=majority
#
# Format for Local MongoDB container / development:
# MONGODB_URI=mongodb://localhost:27017/orbit_ai
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.xxxxx.mongodb.net/orbit_ai?retryWrites=true&w=majority
DATABASE_NAME=orbit_ai

# Application & Session Secret Key (Must be at least 32 characters in production)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-secure-secret-key-at-least-32-chars

# Environment & Networking
FLASK_ENV=production
# Set to your Vercel domains (comma-separated, wildcards like *.vercel.app supported for preview deploys)
# Production example: FRONTEND_URL=https://orbit-ai.vercel.app,https://*.vercel.app,http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Rate Limiting & Message Constraints
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
MAX_CONTEXT_MESSAGES=16
MAX_MESSAGE_LENGTH=8000
